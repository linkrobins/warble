{
    "name": "linkrobins/flarum-warble",
    "description": "Warble — hosted realtime for Flarum. Installs + configures flarum/realtime to use the managed Warble websocket service with one key.",
    "keywords": [
        "flarum",
        "realtime",
        "websocket",
        "warble"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Link Robins",
            "email": "karl@linkrobins.com",
            "homepage": "https://linkrobins.com"
        }
    ],
    "homepage": "https://linkrobins.com/warble",
    "support": {
        "issues": "https://github.com/linkrobins/flarum-warble/issues",
        "source": "https://github.com/linkrobins/flarum-warble",
        "docs": "https://linkrobins.com/warble",
        "forum": "https://linkrobins.com/forum",
        "email": "karl@linkrobins.com"
    },
    "require": {
        "flarum/core": "^2.0",
        "flarum/realtime": "^2.0@RC",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "LinkRobins\\Warble\\": "src/"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "extra": {
        "flarum-extension": {
            "title": "Link Robins Warble",
            "icon": {
                "name": "fas fa-bolt",
                "color": "#07adcc",
                "backgroundColor": "#1a2535"
            }
        }
    }
}
