{
    "name": "linkrobins/flarum-warble",
    "description": "Warble — hosted realtime for Flarum. Installs + configures flarum/realtime to use the managed Warble websocket service with one key.",
    "keywords": ["flarum", "realtime", "websocket", "warble"],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "flarum/core": "^2.0",
        "flarum/realtime": "^2.0@RC"
    },
    "autoload": {
        "psr-4": {
            "LinkRobins\\Warble\\": "src/"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "extra": {
        "flarum-extension": {
            "title": "Link Robins Warble",
            "icon": {
                "name": "fas fa-bolt",
                "color": "#07adcc",
                "backgroundColor": "#1a2535"
            }
        }
    }
}
